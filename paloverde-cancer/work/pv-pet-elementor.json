[{"id":"8ca1be5","elType":"container","settings":{"flex_direction":"column","background_background":"gradient","background_image":{"id":"","url":"","alt":"main hero banner img1","source":"library","size":""},"background_position":"center left","background_attachment":"scroll","background_repeat":"no-repeat","background_size":"cover","background_overlay_background":"classic","padding":{"unit":"px","top":"200","right":"40","bottom":"100","left":"40","isLinked":false},"padding_tablet":{"unit":"px","top":"200","right":"32","bottom":"100","left":"32","isLinked":false},"padding_mobile":{"unit":"px","top":"200","right":"24","bottom":"150","left":"24","isLinked":false},"__globals__":{"background_overlay_color":"globals\/colors?id=astglobalcolor7","background_color":"globals\/colors?id=astglobalcolor4","background_color_b":"globals\/colors?id=astglobalcolor6"},"_title":"Container","background_image_mobile":{"url":"https:\/\/875051.us16.myftpupload.com\/wp-content\/uploads\/2025\/10\/main-hero-banner-img1.jpg","id":104,"size":"2048x2048","alt":"main hero banner img1","source":"library"},"background_position_mobile":"initial","background_xpos_mobile":{"unit":"px","size":-753,"sizes":[]},"background_ypos_mobile":{"unit":"px","size":-1,"sizes":[]},"background_bg_width_mobile":{"unit":"px","size":1000,"sizes":[]},"hover_parallax":[{"layer_position_vr":{"unit":"%","size":30},"layer_position_hr":{"unit":"%","size":40},"_id":"ffc753c"},{"layer_position_vr":{"unit":"%","size":60},"layer_position_hr":{"unit":"%","size":20},"_id":"a10f982"}],"min_height":{"unit":"px","size":400,"sizes":[]},"ha_cmc_text":"Happy Addons"},"elements":[{"id":"318a198","elType":"widget","settings":{"html":" <section id=\"pet-scan\" style=\"padding:80px 20px; background:#000; font-family:'Poppins', sans-serif; color:#ffffff;\">\r\n  <div style=\"max-width:1100px; margin:0 auto;\">\r\n\r\n    <h2 style=\"font-size:36px; font-weight:700; margin-bottom:15px; text-align:center; color:#ffffff;\">\r\n      PET Scan Imaging\r\n    <\/h2>\r\n    <p style=\"font-size:18px; color:#ffffff; text-align:center; margin-bottom:50px;\">\r\n      Advanced imaging technology helping our specialists detect, plan, and treat with precision.\r\n    <\/p>\r\n\r\n    <div style=\"display:flex; flex-wrap:wrap; gap:50px; align-items:center;\">\r\n\r\n      <div style=\"flex:1 1 550px;\">\r\n        <p style=\"font-size:17px; line-height:1.8; color:#ffffff; margin-bottom:20px;\">\r\n          Palo Verde Cancer Specialists is owned and operated by physicians who live within our community. \r\n          We offer a caring and compassionate environment and a comprehensive range of innovative services designed \r\n          to provide our patients with the best treatment available. Our oncology specialists work hard to find the most \r\n          appropriate cancer treatment for each individual. For some patients, a PET scan may be right for them.\r\n        <\/p>\r\n\r\n        <h3 style=\"font-size:22px; color:#ffffff; font-weight:600; margin:30px 0 15px;\">What is a PET Scan?<\/h3>\r\n        <p style=\"font-size:17px; line-height:1.8; color:#ffffff; margin-bottom:20px;\">\r\n          A positron emission tomography (PET) scan can be used alongside other cancer treatments to achieve the best results. \r\n          For some types of cancer, it helps identify where the cancer is located and its stage. Knowing this allows your \r\n          doctor to determine the most effective treatment plan for you.\r\n        <\/p>\r\n\r\n        <h3 style=\"font-size:22px; color:#ffffff; font-weight:600; margin:30px 0 15px;\">PET Scan at Palo Verde Cancer Specialists<\/h3>\r\n        <p style=\"font-size:17px; line-height:1.8; color:#ffffff; margin-bottom:15px;\">\r\n          We\u2019ve added PET Scan Imaging to our comprehensive services. Our oncology specialists believe PET scans are an invaluable tool \r\n          that can complement other cancer treatments and help patients overcome cancer. At Palo Verde, every PET scan includes:\r\n        <\/p>\r\n\r\n        <ul style=\"list-style:none; padding:0; margin:20px 0; color:#ffffff;\">\r\n          <li style=\"margin-bottom:8px;\">\u2705 Same-day results<\/li>\r\n          <li style=\"margin-bottom:8px;\">\u2705 Immediate appointments available<\/li>\r\n          <li style=\"margin-bottom:8px;\">\u2705 Fast and convenient scheduling<\/li>\r\n          <li style=\"margin-bottom:8px;\">\u2705 Acceptance of all major insurance plans<\/li>\r\n        <\/ul>\r\n\r\n        <p style=\"font-size:17px; line-height:1.8; color:#ffffff; margin-bottom:30px;\">\r\n          We understand that results are important to your recovery. That\u2019s why we work diligently to provide PET scan results \r\n          as quickly as possible so you and your doctor can decide the next steps for your treatment.\r\n        <\/p>\r\n\r\n        <h3 style=\"font-size:22px; color:#ffffff; font-weight:600; margin:30px 0 15px;\">Contact Palo Verde Cancer Specialists Today!<\/h3>\r\n        <p style=\"font-size:17px; line-height:1.8; color:#ffffff; margin-bottom:40px;\">\r\n          If you believe a PET scan may support your treatment or would like more information, please contact Palo Verde Cancer Specialists. \r\n          Our oncology team will gladly discuss the benefits and options with you. We\u2019re here to help you in your fight against cancer.\r\n        <\/p>\r\n\r\n        <div style=\"text-align:left;\">\r\n          <a href=\"https:\/\/875051.us16.myftpupload.com\/schedule\/\" \r\n             style=\"\r\n              display:inline-block;\r\n              padding:14px 34px;\r\n              background:linear-gradient(90deg, #0072ff, #00c6ff);\r\n              color:#ffffff;\r\n              font-weight:600;\r\n              font-size:17px;\r\n              border-radius:50px;\r\n              text-decoration:none;\r\n              letter-spacing:0.5px;\r\n              box-shadow:0 6px 20px rgba(0, 114, 255, 0.4);\r\n              transition:all 0.3s ease;\r\n             \"\r\n             onmouseover=\"this.style.background='linear-gradient(90deg,#00c6ff,#0072ff)'; this.style.transform='translateY(-3px)';\"\r\n             onmouseout=\"this.style.background='linear-gradient(90deg,#0072ff,#00c6ff)'; this.style.transform='translateY(0)';\">\r\n            Schedule Appointment \u2192\r\n          <\/a>\r\n        <\/div>\r\n      <\/div>\r\n\r\n      <div style=\"flex:1 1 400px; text-align:center;\">\r\n        <div style=\"\r\n          border-radius:20px;\r\n          overflow:hidden;\r\n          background:linear-gradient(135deg, #0072ff, #00c6ff);\r\n          padding:6px;\r\n          box-shadow:0 10px 25px rgba(0,0,0,0.3);\r\n          transition:all 0.3s ease;\r\n        \" onmouseover=\"this.style.transform='scale(1.03)';\" onmouseout=\"this.style.transform='scale(1)';\">\r\n          <img src=\"https:\/\/875051.us16.myftpupload.com\/wp-content\/uploads\/2025\/10\/Siemens-Biograph.jpg\" \r\n               alt=\"PET Scan\" \r\n               style=\"width:100%; display:block; border-radius:15px;\">\r\n        <\/div>\r\n      <\/div>\r\n\r\n    <\/div>\r\n  <\/div>\r\n<\/section>","ha_cmc_text":"Happy Addons"},"elements":[],"widgetType":"html"}],"isInner":false},{"id":"c3648dc","elType":"container","settings":{"flex_direction":"column","background_image":{"id":"","url":"","alt":"main hero banner img1","source":"library","size":""},"background_position":"center left","background_attachment":"scroll","background_repeat":"no-repeat","background_size":"cover","background_overlay_background":"classic","padding":{"unit":"px","top":"100","right":"40","bottom":"100","left":"40","isLinked":false},"padding_tablet":{"unit":"px","top":"200","right":"32","bottom":"100","left":"32","isLinked":false},"padding_mobile":{"unit":"px","top":"200","right":"24","bottom":"150","left":"24","isLinked":false},"__globals__":{"background_overlay_color":"globals\/colors?id=astglobalcolor7","background_color":"globals\/colors?id=astglobalcolor4","background_color_b":"globals\/colors?id=astglobalcolor6"},"_title":"Container","background_image_mobile":{"url":"https:\/\/875051.us16.myftpupload.com\/wp-content\/uploads\/2025\/10\/main-hero-banner-img1.jpg","id":104,"size":"2048x2048","alt":"main hero banner img1","source":"library"},"background_position_mobile":"initial","background_xpos_mobile":{"unit":"px","size":-753,"sizes":[]},"background_ypos_mobile":{"unit":"px","size":-1,"sizes":[]},"background_bg_width_mobile":{"unit":"px","size":1000,"sizes":[]},"hover_parallax":[{"layer_position_vr":{"unit":"%","size":30},"layer_position_hr":{"unit":"%","size":40},"_id":"ffc753c"},{"layer_position_vr":{"unit":"%","size":60},"layer_position_hr":{"unit":"%","size":20},"_id":"a10f982"}],"min_height":{"unit":"px","size":400,"sizes":[]},"ha_cmc_text":"Happy Addons"},"elements":[{"id":"2d99256","elType":"widget","settings":{"html":"<section id=\"pet-faq\" style=\"background:#000; padding:80px 20px; font-family:'Poppins', sans-serif; color:#fff;\">\r\n  <div style=\"max-width:900px; margin:0 auto;\">\r\n\r\n    <h2 style=\"text-align:center; font-size:36px; font-weight:700; margin-bottom:50px; color:#ffffff;\">\r\n      PET Scan \u2013 Frequently Asked Questions\r\n    <\/h2>\r\n\r\n    <div class=\"faq-container\">\r\n      <div class=\"faq-item\">\r\n        <button class=\"faq-question\">What is the purpose of a PET scan?<\/button>\r\n        <div class=\"faq-answer\">\r\n          <p>\r\n            A PET scan helps your doctor detect cancer, determine its stage, and monitor how well your treatment is working.\r\n            It provides detailed images that reveal how your organs and tissues are functioning.\r\n          <\/p>\r\n        <\/div>\r\n      <\/div>\r\n\r\n      <div class=\"faq-item\">\r\n        <button class=\"faq-question\">Is a PET scan painful?<\/button>\r\n        <div class=\"faq-answer\">\r\n          <p>\r\n            No, a PET scan is not painful. The procedure involves a small injection of a radioactive tracer, followed by a rest period before the scan. Most patients find it simple and comfortable.\r\n          <\/p>\r\n        <\/div>\r\n      <\/div>\r\n\r\n      <div class=\"faq-item\">\r\n        <button class=\"faq-question\">How long does a PET scan take?<\/button>\r\n        <div class=\"faq-answer\">\r\n          <p>\r\n            The full process typically takes about 1 to 2 hours, including preparation time. The actual scanning portion usually lasts between 20 to 40 minutes.\r\n          <\/p>\r\n        <\/div>\r\n      <\/div>\r\n\r\n      <div class=\"faq-item\">\r\n        <button class=\"faq-question\">Are there any risks associated with PET scans?<\/button>\r\n        <div class=\"faq-answer\">\r\n          <p>\r\n            PET scans are very safe. The amount of radioactive tracer used is extremely small and leaves the body naturally within a short period of time. Your physician will ensure it\u2019s appropriate for you.\r\n          <\/p>\r\n        <\/div>\r\n      <\/div>\r\n\r\n      <div class=\"faq-item\">\r\n        <button class=\"faq-question\">When will I get my PET scan results?<\/button>\r\n        <div class=\"faq-answer\">\r\n          <p>\r\n            At Palo Verde Cancer Specialists, we provide same-day PET scan results whenever possible. Your doctor will review the images and discuss the next steps in your treatment plan right away.\r\n          <\/p>\r\n        <\/div>\r\n      <\/div>\r\n    <\/div>\r\n\r\n  <\/div>\r\n<\/section>\r\n\r\n<style>\r\n.faq-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 15px;\r\n}\r\n.faq-item {\r\n  border-radius:12px;\r\n  overflow:hidden;\r\n  background:rgba(255,255,255,0.05);\r\n  \/* Optional: Kept a subtle blue border for structure, or change to rgba(255,255,255,0.2) for full white *\/\r\n  border:1px solid rgba(255,255,255,0.2);\r\n  transition:all 0.3s ease;\r\n}\r\n.faq-item:hover {\r\n  box-shadow:0 0 20px rgba(255,255,255,0.1);\r\n  transform:translateY(-2px);\r\n}\r\n.faq-question {\r\n  width:100%;\r\n  background:none;\r\n  border:none;\r\n  outline:none;\r\n  \/* Changed Question Color to White *\/\r\n  color:#ffffff;\r\n  text-align:left;\r\n  font-size:18px;\r\n  font-weight:600;\r\n  padding:20px;\r\n  cursor:pointer;\r\n  transition:all 0.3s ease;\r\n}\r\n.faq-question::after {\r\n  content:\"+\";\r\n  float:right;\r\n  font-size:22px;\r\n  \/* Changed Icon Color to White *\/\r\n  color:#ffffff;\r\n  transition:transform 0.3s ease;\r\n}\r\n.faq-item.active .faq-question::after {\r\n  transform:rotate(45deg);\r\n}\r\n.faq-answer {\r\n  max-height:0;\r\n  overflow:hidden;\r\n  transition:max-height 0.5s ease, padding 0.3s ease;\r\n  background:rgba(0,0,0,0.6);\r\n}\r\n.faq-item.active .faq-answer {\r\n  max-height:300px;\r\n  padding:0 20px 20px 20px;\r\n}\r\n.faq-answer p {\r\n  \/* Changed Answer Text Color to White *\/\r\n  color:#ffffff;\r\n  line-height:1.8;\r\n  margin:0;\r\n  font-size:16px;\r\n}\r\n@media (max-width:768px) {\r\n  #pet-faq h2 { font-size:28px; }\r\n  .faq-question { font-size:16px; padding:16px; }\r\n  .faq-answer p { font-size:15px; }\r\n}\r\n<\/style>\r\n\r\n<script>\r\ndocument.querySelectorAll(\".faq-question\").forEach((button)=>{\r\n  button.addEventListener(\"click\",()=>{\r\n    const item = button.parentElement;\r\n    item.classList.toggle(\"active\");\r\n  });\r\n});\r\n<\/script>","ha_cmc_text":"Happy Addons"},"elements":[],"widgetType":"html"}],"isInner":false},{"id":"dd9456a","elType":"container","settings":{"flex_direction":"column","container_type":"grid","boxed_width":{"unit":"px","size":1200,"sizes":[]},"min_height":{"unit":"px","size":0,"sizes":[]},"flex_gap":{"column":"1","row":"1","isLinked":true,"unit":"px","size":1},"grid_columns_grid":{"unit":"fr","size":1,"sizes":[]},"grid_rows_grid":{"unit":"fr","size":1,"sizes":[]},"background_color_b":"#410000","hover_parallax":[{"layer_position_vr":{"unit":"%","size":30},"layer_position_hr":{"uni