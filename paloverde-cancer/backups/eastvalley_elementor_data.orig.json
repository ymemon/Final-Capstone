      <div class=\"insurance-card\">\r\n        <img src=\"https:\/\/upload.wikimedia.org\/wikipedia\/commons\/f\/fb\/Cigna_logo.svg\" alt=\"Cigna\">\r\n      <\/div>\r\n\r\n      <!-- \ud83c\udfe5 Medicare -->\r\n      <div class=\"insurance-card\">\r\n        <img src=\"https:\/\/upload.wikimedia.org\/wikipedia\/commons\/2\/28\/Medicare_logo.svg\" alt=\"Medicare\">\r\n      <\/div>\r\n\r\n      <!-- \ud83c\udfe5 Humana -->\r\n      <div class=\"insurance-card\">\r\n        <img src=\"https:\/\/upload.wikimedia.org\/wikipedia\/commons\/b\/b3\/Humana_logo.svg\" alt=\"Humana\">\r\n      <\/div>\r\n    <\/div>\r\n\r\n    <p class=\"billing-note\">\r\n      If your insurance provider isn\u2019t listed, please contact our office for assistance with verification and billing options.\r\n    <\/p>\r\n\r\n   \r\n  <\/div>\r\n<\/section>\r\n\r\n<!-- \ud83d\udc85 Styling -->\r\n<style>\r\n.insurance-section {\r\n  background: #fff;\r\n  padding: 80px 20px;\r\n  font-family: 'Roboto', sans-serif;\r\n  text-align: center;\r\n  color: #000;\r\n}\r\n\r\n.insurance-container {\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.insurance-section h2 {\r\n  color: #002B5B;\r\n  font-size: 32px;\r\n  font-weight: 800;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.subtitle {\r\n  color: #555;\r\n  font-size: 16px;\r\n  margin-bottom: 50px;\r\n}\r\n\r\n\/* \ud83e\ude7a Logo Grid *\/\r\n.insurance-logos {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\r\n  gap: 30px;\r\n  justify-items: center;\r\n  align-items: center;\r\n}\r\n\r\n.insurance-card {\r\n  background: #F8F9FA;\r\n  border-radius: 12px;\r\n  box-shadow: 0 4px 10px rgba(0,0,0,0.08);\r\n  padding: 30px;\r\n  height: 140px;\r\n  width: 100%;\r\n  max-width: 250px;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.insurance-card:hover {\r\n  background: #000000;\r\n  transform: translateY(-5px);\r\n  box-shadow: 0 8px 20px rgba(0,0,0,0.12);\r\n}\r\n\r\n.insurance-card img {\r\n  max-height: 60px;\r\n  max-width: 80%;\r\n  object-fit: contain;\r\n  filter: brightness(0) invert(0);\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.insurance-card:hover img {\r\n  filter: brightness(0) invert(1);\r\n}\r\n\r\n.billing-note {\r\n  margin-top: 40px;\r\n  color: #333;\r\n  font-size: 15px;\r\n  line-height: 1.6;\r\n}\r\n\r\n\r\n\/* \ud83d\udcf1 Responsive *\/\r\n@media (max-width: 768px) {\r\n  .insurance-section { padding: 60px 15px; }\r\n  .insurance-card {\r\n    height: 120px;\r\n    padding: 20px;\r\n    max-width: 100%;\r\n  }\r\n}\r\n<\/style>\r\n","ha_cmc_text":"Happy Addons"},"elements":[],"widgetType":"html"},{"id":"773ceef","elType":"widget","settings":{"space":{"unit":"px","size":90,"sizes":[]},"ha_cmc_text":"Happy Addons"},"elements":[],"widgetType":"spacer"}],"isInner":true}],"isInner":false},{"id":"cffa40f","elType":"container","settings":{"flex_direction":"column","content_width":"full","hover_parallax":[{"layer_position_vr":{"unit":"%","size":30},"layer_position_hr":{"unit":"%","size":40},"_id":"0e0d4e3"},{"layer_position_vr":{"unit":"%","size":60},"layer_position_hr":{"unit":"%","size":20},"_id":"2ad751d"}],"ha_cmc_text":"Happy Addons"},"elements":[{"id":"c060aed","elType":"container","settings":{"container_type":"grid","presetTitle":"Grid","presetIcon":"eicon-container-grid","content_width":"full","grid_columns_grid":{"unit":"fr","size":1,"sizes":[]},"grid_rows_grid":{"unit":"fr","size":1,"sizes":[]},"hover_parallax":[{"layer_position_vr":{"unit":"%","size":30},"layer_position_hr":{"unit":"%","size":40},"_id":"f5653b6"},{"layer_position_vr":{"unit":"%","size":60},"layer_position_hr":{"unit":"%","size":20},"_id":"e26337a"}],"ha_cmc_text":"Happy Addons"},"elements":[{"id":"ed3e943","elType":"widget","settings":{"html":"<!-- \ud83d\ude97 Directions & Parking Section -->\r\n<section class=\"directions-section\">\r\n  <div class=\"directions-container\">\r\n    <h2>Directions & Parking<\/h2>\r\n    <p class=\"subtitle\">Find the easiest way to reach and park at our East Valley.<\/p>\r\n\r\n    <div class=\"accordion\">\r\n      <!-- 1\ufe0f\u20e3 Driving Directions -->\r\n      <div class=\"accordion-item\">\r\n        <button class=\"accordion-header\">\r\n          <span>\ud83d\ude98 Driving from Major Routes<\/span>\r\n          <span class=\"icon\">+<\/span>\r\n        <\/button>\r\n        <div class=\"accordion-content\">\r\n          <p>We\u2019re located at <strong> 1488 W Elliot Rd, Gilbert, AZ 85233,<\/strong> in the heart of Gilbert. From US-60 (Superstition Freeway), take the Val Vista Drive exit and head south. Turn west on Elliot Road and our facility will be on the north side, just past Cooper Road. Easily accessible from Loop 202 and surrounding East Valley areas.<\/p>\r\n        <\/div>\r\n      <\/div>\r\n\r\n      <!-- 2\ufe0f\u20e3 Parking Info -->\r\n      <div class=\"accordion-item\">\r\n        <button class=\"accordion-header\">\r\n          <span>\ud83c\udd7f\ufe0f Parking Information<\/span>\r\n          <span class=\"icon\">+<\/span>\r\n        <\/button>\r\n        <div class=\"accordion-content\">\r\n          <p>Free on-site parking is available in the lot directly in front of our building. Visitor and patient parking stalls are plentiful, including several accessible spaces situated very close to the main entrance for your convenience.<\/p>\r\n        <\/div>\r\n      <\/div>\r\n\r\n      <!-- 3\ufe0f\u20e3 Public Transit -->\r\n      <div class=\"accordion-item\">\r\n        <button class=\"accordion-header\">\r\n          <span>\ud83d\ude8c Public Transit Options<\/span>\r\n          <span class=\"icon\">+<\/span>\r\n        <\/button>\r\n        <div class=\"accordion-content\">\r\n          <p><strong>Valley Metro bus routes 45 and 104 <\/strong> serve the Gilbert-Elliot corridor, with stops near the intersection of Elliot Rd and Cooper Rd. These stops are within walking distance of our clinic and provide easy transit access from surrounding neighborhoods.<\/p>\r\n        <\/div>\r\n      <\/div>\r\n    <\/div>\r\n  <\/div>\r\n<\/section>\r\n\r\n<!-- \ud83d\udc85 Enhanced Styling -->\r\n<style>\r\n.directions-section {\r\n  background: linear-gradient(180deg, #F8F9FA 0%, #FFFFFF 100%);\r\n  padding: 90px 20px;\r\n  font-family: 'Roboto', sans-serif;\r\n  color: #000;\r\n}\r\n\r\n.directions-container {\r\n  max-width: 900px;\r\n  margin: 0 auto;\r\n  text-align: center;\r\n}\r\n\r\n.directions-container h2 {\r\n  font-size: 32px;\r\n  font-weight: 800;\r\n  color: #002B5B;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.directions-container .subtitle {\r\n  font-size: 16px;\r\n  color: #555;\r\n  margin-bottom: 40px;\r\n}\r\n\r\n.accordion-item {\r\n  background: #fff;\r\n  border: 1px solid #e3e3e3;\r\n  border-radius: 12px;\r\n  margin-bottom: 20px;\r\n  overflow: hidden;\r\n  box-shadow: 0 6px 20px rgba(0,0,0,0.06);\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.accordion-item:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 10px 25px rgba(0,0,0,0.1);\r\n}\r\n\r\n.accordion-header {\r\n  width: 100%;\r\n  background: linear-gradient(90deg, #002B5B, #004080);\r\n  color: #fff;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  text-align: left;\r\n  padding: 18px 24px;\r\n  font-size: 17px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  border: none;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.accordion-header:hover {\r\n  background: linear-gradient(90deg, #004080, #0059b3);\r\n}\r\n\r\n.accordion-header .icon {\r\n  font-size: 22px;\r\n  transition: transform 0.3s ease;\r\n}\r\n\r\n.accordion-item.active .icon {\r\n  transform: rotate(45deg);\r\n}\r\n\r\n.accordion-content {\r\n  display: none;\r\n  padding: 20px 24px;\r\n  text-align: left;\r\n  font-size: 15px;\r\n  color: #333;\r\n  background: #fff;\r\n  line-height: 1.6;\r\n  animation: fadeIn 0.4s ease;\r\n}\r\n\r\n.accordion-item.active .accordion-content {\r\n  display: block;\r\n}\r\n\r\n@keyframes fadeIn {\r\n  from {opacity: 0; transform: translateY(-10px);}\r\n  to {opacity: 1; transform: translateY(0);}\r\n}\r\n\r\n\/* \ud83d\udcf1 Responsive *\/\r\n@media (max-width: 768px) {\r\n  .directions-container h2 {\r\n    font-size: 26px;\r\n  }\r\n  .accordion-header {\r\n    font-size: 15px;\r\n    padding: 15px 20px;\r\n  }\r\n  .accordion-content {\r\n    font-size: 14px;\r\n    padding: 15px 20px;\r\n  }\r\n}\r\n<\/style>\r\n\r\n<!-- \u2699\ufe0f Accordion Functionality -->\r\n<script>\r\ndocument.querySelectorAll(\".accordion-header\").forEach(header => {\r\n  header.addEventListener(\"click\", () => {\r\n    const item = header.parentElement;\r\n    item.classList.toggle(\"active\");\r\n  });\r\n});\r\n<\/script>\r\n","ha_cmc_text":"Happy Addons"},"elements":[],"widgetType":"html"},{"id":"88258e9","elType":"widget","settings":{"ha_cmc_text":"Happy Addons"},"elements":[],"widgetType":"spacer"}],"isInner":true}],"isInner":false},{"id":"7f9e998","elType":"container","settings":{"flex_direction":"column","hover_parallax":[{"layer_position_vr":{"unit":"%","size":30},"layer_position_hr":{"unit":"%","size":40},"_id":"93bbab0"},{"layer_position_vr":{"unit":"%","size":60},"layer_position_hr":{"unit":"%","size":20},"_id":"686e610"}],"ha_cmc_text":"Happy Addons"},"elements":[{"id":"6d18ed2","elType":"container","settings":{"container_type":"grid","presetTitle":"Grid","presetIcon":"eicon-container-grid","grid_columns_grid":{"unit":"fr","size":1,"sizes":[]},"grid_rows_grid":{"unit":"fr","size":1,"sizes":[]},"hover_parallax":[{"layer_position_vr":{"unit":"%","size":30},"layer_position_hr":{"unit":"%","size":40},"_id":"269cd55"},{"layer_position_vr":{"unit":"%","size":60},"layer_position_hr":{"unit":"%","size":20},"_id":"fc3e41b"}],"ha_cmc_text":"Happy Addons"},"elements":[{"id":"bf92637","elType":"widget","settings":{"ha_cmc_text":"Happy Addons"},"elements":[],"widgetType":"spacer"},{"id":"41adb43","elType":"widget","settings":{"htm