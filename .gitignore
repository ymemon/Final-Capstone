# NOTE: github.com/ymemon/Final-Capstone is a PUBLIC repository.
# Anything committed here is world-readable. Check `git status` before
# `git add -A` - the working tree holds client work that should not ship.

# Credentials never belong in this repo. They live in
# C:\Users\yasir\.claude-tools\azwebcorp-creds.json and are loaded at runtime.
azwebcorp-creds.json
*-oauth-token.json
*-oauth-client.json
*creds*.json
*-key.json

# Raw client mail and API dumps pulled by the watcher / ticket sync.
# These hold real client correspondence - keep them off GitHub.
client-watch/mail_dump.json
client-watch/mail_list.txt
client-watch/state.json
client-watch/idle_state.json
client-watch/idle_events.jsonl
client-watch/ack_state.json
seo-audit/ticket-sync/fetch_*.json
seo-audit/ticket-sync/run_*.json
seo-audit/ticket-sync/*_err.txt

# Logs
*.log
client-watch/watch_log.txt

# Runtime lock files for background daemons - transient PID/lock state, one
# of them is even held open by a live process (permission-denied on add).
*.lock

# Python
__pycache__/
*.pyc

# Vendor / generated trees. 4,389 files of someone else's code that would
# otherwise land in a public repo on the next `git add -A`.
local-sites/
node_modules/

# Staged deploy scripts awaiting approval. Transient by nature, and some
# carry client page-gate passwords (e.g. the EIT hardware-supply demo).
client-watch/staged/

# Portal owner-tier credentials - never commit these.
seo-audit/portal/owner-htpasswd.local
seo-audit/portal/owner-password.local
seo-audit/portal/owner-auth.local
seo-audit/portal/.deploy-owner/

# Portal build inputs and outputs. Both embed real client search and analytics
# figures, and this repository is public - only the source that produces them
# belongs here.
seo-audit/portal/data/
seo-audit/portal/dist/
seo-audit/portal/azwebcorp/index.html
seo-audit/portal/.deploy-live/

# Full client roster (names, work emails, site URLs, internal notes) used by
# the mail-watcher's allowlist - business-confidential, keep off a public repo.
client-watch/clients.json

# Leftover Chromium browser-profile directories from screenshot/automation
# tooling (found 2026-09-14) - contain real browser History/Login Data/
# Cookies/Web Data SQLite files, never source, never appropriate to commit.
rebound-body-studio/build/cd5/
rebound-body-studio/build/cd6/
rebound-body-studio/build/cd7/
rebound-body-studio/build/cd8/
seo-audit/weekly-report/cd/

# Corrupted zero/near-zero-byte filenames from a broken shell command in some
# past session - pure noise, no content.
rebound-body-studio/fetchColumn()
seo-audit/tools/flush_cdn()
